# pnpm security and configuration defaults
# https://pnpm.io/npmrc

# ============================================
# SECURITY SETTINGS
# ============================================

# Only allow installation of packages from npm registry
# This prevents accidentally installing from unknown registries
registry=https://registry.npmjs.org/

# Strict SSL for all requests - never disable in production
strict-ssl=true

# Don't run lifecycle scripts (postinstall, preinstall, etc.) automatically
# Security: prevents malicious scripts from running during install
ignore-scripts=true

# Only allow built dependencies defined in onlyBuiltDependencies.json
# Requires explicit opt-in for packages that need compilation
onlyBuiltDependenciesFile=.pnpm/onlyBuiltDependencies.json

# ============================================
# LOCKFILE AND DETERMINISTIC INSTALLS
# ============================================

# Always use the lockfile - fail if it needs updates
prefer-frozen-lockfile=true

# Don't update pnpm-lock.yaml automatically during install
frozen-lockfile=true

# ============================================
# PERFORMANCE SETTINGS
# ============================================

# Use hard links for node_modules (saves disk space)
# Fallback to copy if hard links not supported
package-import-method=auto

# Store packages in content-addressable store
store-dir=.pnpm-store

# ============================================
# MODULE RESOLUTION
# ============================================

# Use hoisted node_modules for compatibility with some tools
node-linker=isolated

# ============================================
# LOGGING AND OUTPUT
# ============================================

# Reduce noise during install
loglevel=warn

# Show progress bar
progress=true
