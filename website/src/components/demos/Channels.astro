---
const cells = Array.from({ length: 8 * 5 }, (_, index) => ({ value: 40 + ((index * 131) % 200) }));
const selected = 9;
const selectedCell = cells[selected];
---
<figure class="mock mock--views" data-demo="channels" aria-hidden="true">
  <div class="views__bar">
    <div class="seg">
      <span class="seg__item seg__item--on">Channels</span>
      <span class="seg__item">Values</span>
      <span class="seg__item">Both</span>
    </div>
    <div class="themes">
      <i style="--dot:#06b6d4"></i>
      <i class="i--on" style="--dot:#3b82f6"></i>
      <i style="--dot:#a855f7"></i>
      <i style="--dot:#ef4444"></i>
      <i style="--dot:#71717a"></i>
    </div>
  </div>

  <div class="ch-grid" data-grid>
    {cells.map((cell, index) => (
      <div class:list={['ch', index === selected && 'ch--sel', cell.value === 0 && 'ch--off']} data-ch>
        <i class="ch__bar" style={`--v:${(cell.value / 255).toFixed(3)}`}></i>
        <span class="ch__num">{index + 1}</span>
        <span class="ch__val">{cell.value}</span>
      </div>
    ))}
  </div>

  <div class="sel">
    <span>Channel</span><b data-sel-num>{selected + 1}</b>
    <span>Value</span><b data-sel-val>{selectedCell.value} ({Math.ceil((selectedCell.value / 255) * 100)}%)</b>
  </div>
</figure>

<script>
  import { runDemo } from '../../lib/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="channels"]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cells = [...grid.querySelectorAll<HTMLElement>('[data-ch]')];
    const bars = cells.map((cell) => cell.querySelector<HTMLElement>('.ch__bar')!);
    const values = cells.map((cell) => Number(cell.querySelector<HTMLElement>('.ch__val')!.textContent));
    const selNum = root.querySelector<HTMLElement>('[data-sel-num]')!;
    const selVal = root.querySelector<HTMLElement>('[data-sel-val]')!;
    const items = [...root.querySelectorAll<HTMLElement>('.seg__item')];
    let mode = 0;
    let selected = 9;
    let tick = 0;

    const select = (index: number) => {
      cells[selected].classList.remove('ch--sel');
      selected = index;
      cells[selected].classList.add('ch--sel');
      selNum.textContent = String(selected + 1);
      selVal.textContent = `${values[selected]} (${Math.ceil((values[selected] / 255) * 100)}%)`;
    };

    const setMode = (index: number) => {
      mode = index;
      items.forEach((item, itemIndex) => item.classList.toggle('seg__item--on', itemIndex === index));
      grid.classList.toggle('ch-grid--values', index === 1);
      grid.classList.toggle('ch-grid--both', index === 2);
    };

    runDemo(root, async (ctx) => {
      while (true) {
        for (let update = 0; update < 12; update += 1) {
          const index = Math.floor(Math.random() * cells.length);
          const delta = Math.round(Math.random() * 90 - 45);
          values[index] = Math.min(255, Math.max(0, values[index] + delta));
          const pct = (values[index] / 255) * 100;
          ctx.animate(bars[index], { scaleY: values[index] / 255 }, { duration: 0.35, ease: 'easeOut' });
          cells[index].querySelector<HTMLElement>('.ch__val')!.textContent = String(values[index]);
          cells[index].classList.toggle('ch--off', values[index] === 0);
          if (index === selected) {
            selVal.textContent = `${values[index]} (${Math.ceil(pct)}%)`;
          }
        }

        if (tick % 22 === 21) {
          setMode((mode + 1) % 3);
        }
        if (tick % 34 === 33) {
          select(Math.floor(Math.random() * cells.length));
        }

        tick += 1;
        await ctx.wait(0.16);
      }
    });
  });
</script>
