---
import { getCollection, render } from 'astro:content';
import MarketingLayout from '@patopest/astro-theme/layouts/MarketingLayout.astro';
import { project } from '../project';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<MarketingLayout config={project} title={entry.data.title} description={entry.data.description}>
  <Content />
</MarketingLayout>
