---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '@patopest/astro-theme/layouts/DocsLayout.astro';
import type { SidebarItem } from '@patopest/astro-theme/config';
import { project } from '../../project';

type Doc = CollectionEntry<'docs'>;

export async function getStaticPaths() {
  const docs = [...(await getCollection('docs'))].sort(
    (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
  );
  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[index - 1] ?? null, next: docs[index + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props as { entry: Doc; prev: Doc | null; next: Doc | null };
const { Content, headings } = await render(entry);

const sidebar: SidebarItem[] = [...(await getCollection('docs'))]
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .map((doc) => ({ label: doc.data.title, href: `/docs/${doc.id}/` }));

const pager = (doc: Doc | null) => (doc ? { label: doc.data.title, href: `/docs/${doc.id}/` } : undefined);
---
<DocsLayout
  config={project}
  title={entry.data.title}
  description={entry.data.description}
  lead={entry.data.lead}
  sidebar={sidebar}
  headings={headings}
  prev={pager(prev)}
  next={pager(next)}
>
  <Content />
</DocsLayout>
