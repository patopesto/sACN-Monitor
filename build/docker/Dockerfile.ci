# CI Build Environment for sACN Monitor
# Contains all host-side tools needed for wails3 build/package.
# wails3 build internally launches the wails-cross image for actual compilation.
FROM golang:1.26-trixie

ARG TARGETARCH

# Prevent interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Install system build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    pkg-config \
    gcc \
    nsis
# GTK4/WebKitGTK 6.0 is the default Linux backend; GTK3/WebKit2GTK 4.1 is the
# legacy -tags gtk3 path.
RUN apt-get install -y --no-install-recommends \
    libgtk-4-dev \
    libwebkitgtk-6.0-dev \
    libgtk-4-1 \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev
RUN rm -rf /var/lib/apt/lists/*

# Install Node.js 22 (required for latest pnpm)
ARG NODE_VERSION=22.14.0
RUN NODE_ARCH=$(case "${TARGETARCH}" in arm64) echo "arm64" ;; *) echo "x64" ;; esac) && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" | tar xJ -C /usr/local --strip-components=1

# Install pnpm
RUN npm install -g pnpm

# Install Go-based build tools
RUN go install github.com/wailsapp/wails/v3/cmd/wails3@v3.0.0
RUN go install github.com/goreleaser/nfpm/v2/cmd/nfpm@latest

# Install Docker CLI (static binary) so wails3 build can launch containers
ARG DOCKER_VERSION=27.3.1
RUN DOCKER_ARCH=$(case "${TARGETARCH}" in arm64) echo "aarch64" ;; *) echo "x86_64" ;; esac) && \
    curl -fsSL "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_VERSION}.tgz" | tar xz -C /tmp \
    && cp /tmp/docker/docker /usr/local/bin/ \
    && rm -rf /tmp/docker
